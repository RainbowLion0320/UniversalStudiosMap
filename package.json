{
  "name": "universal-beijing-trip-planner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run data:bundle && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "data:fetch": "python3 scripts/fetch_beijing.py",
    "data:bundle": "node scripts/bundle-data.js",
    "android:sync": "npm run build && cap sync android",
    "android:release": "bash scripts/build-android.sh",
    "data:catalog": "python3 scripts/fetch_beijing.py --catalog-only",
    "release:publish": "bash scripts/publish-release.sh"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/share": "^8.0.2",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/RainbowLion0320/UniversalStudiosMap.git"
  },
  "homepage": "https://github.com/RainbowLion0320/UniversalStudiosMap",
  "bugs": {
    "url": "https://github.com/RainbowLion0320/UniversalStudiosMap/issues"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
